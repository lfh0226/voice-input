# Voice Input Configuration
# 流式语音输入配置
# 使用说明：复制此文件为 config.yaml 并填入你的 API 密钥

# 语音识别后端: xunfei(推荐) / tencent / baidu
backend: xunfei

# 快捷键设置
hotkey:
  # 触发键: 按住录音，松开识别
  # 支持: alt, alt_l, alt_r, ctrl, shift, super 或组合键如 ctrl+alt+v
  trigger: "alt_r"
  # 模式: hold(按住) / toggle(切换)
  mode: "hold"

# 录音设置
recording:
  sample_rate: 16000
  channels: 1
  # 每块音频时长(毫秒)，用于流式传输
  # 建议: 80-160ms 可降低 CPU 占用，40ms 延迟最低但 CPU 占用高
  chunk_ms: 80
  # 最长录音时长(秒)
  max_duration: 30

# 讯飞语音识别配置 (推荐 - 支持动态修正)
# 获取方式: https://console.xfyun.cn/ -> 创建应用 -> 语音听写
xunfei:
  app_id: "YOUR_APP_ID"
  api_key: "YOUR_API_KEY"
  api_secret: "YOUR_API_SECRET"
  # 语言: zh_cn(中文), en_us(英文)
  language: "zh_cn"
  # 方言: mandarin(普通话), cantonese(粤语)
  accent: "mandarin"
  # 语音结束静默时长(毫秒), 越大支持越长的停顿, 默认5000
  vad_eos: 5000
  # 音频队列最大长度，0 表示无限制
  max_audio_queue_size: 400
  # 批量发送音频块数量，增大可降低 CPU 占用（建议 4-8）
  batch_chunks: 4
  # 是否复用 WebSocket 连接；默认关闭，真实 API 校准通过后可开启
  reuse_connection: false
  # 松开热键后等待服务端最终结果的最长秒数；没有中间结果时建议 2-3 秒保证稳定
  final_result_timeout: 3.0

# 腾讯语音识别配置 (备选)
# 获取方式: https://console.cloud.tencent.com/asr
tencent:
  app_id: ""
  secret_id: ""
  secret_key: ""

# 百度语音识别配置 (备选)
# 获取方式: https://console.bce.baidu.com/ai/#/ai/speech/
baidu:
  app_id: ""
  api_key: ""
  secret_key: ""

# 音效反馈
sound:
  # 是否启用提示音
  enabled: false

# 文本输入设置
input:
  # 输入方式: clipboard(推荐) / xdotool(X11) / wtype(Wayland)
  # 注意: GNOME Wayland 下只能使用 clipboard 方式
  method: "clipboard"
  # 按键间隔(秒)
  type_delay: 0.005

# 通知设置 (建议关闭)
notification:
  enabled: false
  show_status: false
  show_result: false

# 日志设置
logging:
  # 日志级别: debug, info, warning, error
  level: "info"
  # 是否打印音频块处理信息（debug级别有效）
  show_audio_chunks: false
  # 是否打印识别的文本内容（debug级别有效）
  show_recognized_text: false
